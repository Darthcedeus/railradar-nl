# On your EXISTING Caddy VM, add this site block to its existing Caddyfile.
# Replace APP_VM_TAILSCALE_IP with the Ubuntu app VM's actual 100.x.y.z address.
trein.humza.xyz {
    encode zstd gzip
    reverse_proxy http://APP_VM_TAILSCALE_IP:3000
    header Strict-Transport-Security "max-age=31536000"
}
